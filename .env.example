# Opzionale. Se manca, il predictor legge ../telegram-offerte-sconto/.env
# (stesso bot delle offerte: TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID).

# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Cartella alternativa del bot offerte, se non è accanto a questo repo:
# OFFERTE_NOTIFICATIONS_DIR=

# Cloud (GitHub Actions): stessi valori come secret del repo.
# TELEGRAM_BOT_TOKEN e TELEGRAM_CHAT_ID
# Coppe UEFA: FOOTBALL_DATA_ORG_TOKEN
# Pinnacle: ODDS_API_KEY (1 chiamata/giorno, cache 20h — non ogni 30 min)
# Betfair: BETFAIR_APP_KEY, BETFAIR_USERNAME, BETFAIR_PASSWORD
# Promemoria Telegram il 1° di ogni mese: tocca il repo (commit o issue)
# altrimenti GitHub spegne gli schedule dopo 60 giorni.

# Betfair Exchange (Delayed App Key). Non committare il .env reale.
# BETFAIR_APP_KEY=
# BETFAIR_APP_KEY_LIVE=
# BETFAIR_APP_NAME=FP3
# BETFAIR_USERNAME=
# BETFAIR_PASSWORD=
